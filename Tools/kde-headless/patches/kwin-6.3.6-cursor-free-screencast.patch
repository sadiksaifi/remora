+/*
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+#pragma once
+
+#include "compositor.h"
+#include "core/output.h"
+#include "core/renderlayer.h"
+#include "core/rendertarget.h"
+#include "opengl/gltexture.h"
+#include "opengl/glutils.h"
+#include "scene/workspacescene.h"
+
+namespace KWin
+{
+
+// Backport the independent scene rendering used by KWin 6.5 screencasts.
+// In 6.3 the cursor is a separate scene/layer, so painting only WorkspaceScene
+// leaves it out. ScreenCastStream continues to implement Embedded/Metadata.
+// Never copy textureForOutput(): virtual outputs have the software cursor in it.
+class ScreencastScene
+{
+public:
+    explicit ScreencastScene(Output *output)
+        : m_output(output)
+        , m_layer(nullptr)
+    {
+        // Capture damage must not schedule another frame on the physical output.
+        m_layer.setDelegate(std::make_unique<SceneDelegate>(Compositor::self()->scene(), output));
+    }
+
+    void render(GLFramebuffer *target)
+    {
+        GLFramebuffer::pushFramebuffer(target);
+        const RenderTarget renderTarget(target);
+        m_layer.delegate()->prePaint();
+        m_layer.resetRepaints();
+        m_layer.delegate()->paint(renderTarget, infiniteRegion());
+        m_layer.delegate()->postPaint();
+        GLFramebuffer::popFramebuffer();
+    }
+
+    GLTexture *texture()
+    {
+        if (!m_texture || m_texture->size() != m_output->pixelSize()) {
+            m_texture = GLTexture::allocate(GL_RGBA8, m_output->pixelSize());
+            if (!m_texture) {
+                return nullptr;
+            }
+            m_texture->setContentTransform(OutputTransform::FlipY);
+            m_texture->setFilter(GL_LINEAR);
+            m_texture->setWrapMode(GL_CLAMP_TO_EDGE);
+        }
+        GLFramebuffer target(m_texture.get());
+        render(&target);
+        return m_texture.get();
+    }
+
+private:
+    Output *const m_output;
+    RenderLayer m_layer;
+    std::unique_ptr<GLTexture> m_texture;
+};
+
+} // namespace KWin
