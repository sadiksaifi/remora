+void PipeWireProduce::setEncoderPaused(bool paused)
+{
+    if (m_encoderPaused.exchange(paused) == paused) {
+        return;
+    }
+    if (!paused) {
+        QMetaObject::invokeMethod(this, [this]() {
+            retryPendingFrame();
+        });
+    }
+}
+
+void PipeWireProduce::retryPendingFrame()
+{
+    if (m_deactivated || m_encoderPaused || m_pendingFilterFrames + m_pendingEncodeFrames >= m_maxPendingFrames) {
+        return;
+    }
+    // A rejected source needs its own submission, then the usual delayed flush.
+    if (m_lastDroppedFrame.dataFrame || m_lastDroppedFrame.dmabuf) {
+        const auto frame = m_lastDroppedFrame;
+        processFrame(frame);
+        return;
+    }
+    if (!m_repeatPending || (!m_lastFrame.dataFrame && !m_lastFrame.dmabuf)) {
+        return;
+    }
+
+    auto frame = m_lastFrame;
+    aboutToEncode(frame);
+    if (!m_encoder->filterFrame(frame)) {
+        return;
+    }
+    // Consume the one-shot flush only after the encoder accepts it.
+    m_lastFrame = {};
+    m_repeatPending = false;
+    m_pendingFilterFrames++;
+    m_passthroughCondition.notify_all();
 }

