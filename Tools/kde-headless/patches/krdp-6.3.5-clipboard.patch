+
+    // Only context lifetime and channel sends cross threads. Clipboard data stays on the main thread.
+    std::mutex contextMutex;
+    bool enabled = false;
+    bool clientHasUnicode = false;
+    bool clientDataPending = false;
+    bool clientOwnsSelection = false;
+    quint64 selectionRevision = 0;
+    quint64 requestedRevision = 0;
+    // mstsc drops a format list sent before its capabilities response; hold until markClientReady()
+    bool clientReady = false;
+    void markClientReady()
+    {
+        if (clientReady) {
+            return;
+        }
+        clientReady = true;
+        QMetaObject::invokeMethod(q, &Clipboard::sendServerData, Qt::QueuedConnection);
+    }
+    std::unique_ptr<const QMimeData> serverData;
+    std::unique_ptr<QMimeData> clientData;
+
+    template<typename Callback>
+    static UINT queueInMainThread(CliprdrServerContext *context, Callback callback)
+    {
+        auto clipboard = static_cast<Clipboard *>(context->custom);
+        // FreeRDP owns callback packet memory. Capture only values or deep copies, never packet pointers.
+        // Never wait for the main thread: it may be joining the RDP thread while Stop joins this callback thread.
+        QMetaObject::invokeMethod(
+            clipboard,
+            [clipboard, callback = std::move(callback)]() {
+                if (clipboard->enabled()) {
+                    callback(*clipboard->d);
+                }
+            },
+            Qt::QueuedConnection);
+        return CHANNEL_RC_OK;
+    }
+
+    static UINT clientCapabilities(CliprdrServerContext *context, const CLIPRDR_CAPABILITIES *)
+    {
+        return queueInMainThread(context, [](Private &d) {
+            d.onClientCapabilities(nullptr);
+        });
+    }
+
+    static UINT clientFormatList(CliprdrServerContext *context, const CLIPRDR_FORMAT_LIST *formatList)
+    {
+        bool hasUnicode = false;
+        for (uint32_t i = 0; i < formatList->numFormats; ++i) {
+            hasUnicode |= formatList->formats[i].formatId == CF_UNICODETEXT;
+        }
+        return queueInMainThread(context, [hasUnicode](Private &d) {
+            CLIPRDR_FORMAT format = {};
+            format.formatId = CF_UNICODETEXT;
+            CLIPRDR_FORMAT_LIST list = {};
+            list.numFormats = hasUnicode ? 1 : 0;
+            list.formats = &format;
+            d.onClientFormatList(&list);
+        });
+    }
+
+    static UINT clientFormatListResponse(CliprdrServerContext *, const CLIPRDR_FORMAT_LIST_RESPONSE *)
+    {
+        return CHANNEL_RC_OK;
+    }
+
+    static UINT clientFormatDataRequest(CliprdrServerContext *context, const CLIPRDR_FORMAT_DATA_REQUEST *request)
+    {
+        const auto formatId = request->requestedFormatId;
+        return queueInMainThread(context, [formatId](Private &d) {
+            CLIPRDR_FORMAT_DATA_REQUEST request = {};
+            request.requestedFormatId = formatId;
+            d.onClientFormatDataRequest(&request);
+        });
+    }
+
+    static UINT clientFormatDataResponse(CliprdrServerContext *context, const CLIPRDR_FORMAT_DATA_RESPONSE *response)
+    {
+        const auto flags = response->common.msgFlags;
+        const QByteArray data =
+            response->requestedFormatData ? QByteArray(reinterpret_cast<const char *>(response->requestedFormatData), response->common.dataLen) : QByteArray();
+        return queueInMainThread(context, [flags, data](Private &d) {
+            CLIPRDR_FORMAT_DATA_RESPONSE response = {};
+            response.common.msgFlags = flags;
+            response.common.dataLen = data.size();
+            response.requestedFormatData = reinterpret_cast<const BYTE *>(data.constData());
+            d.onClientFormatDataResponse(&response);
+        });
+    }
+
+    void requestClientData()
+    {
+        CLIPRDR_FORMAT_DATA_REQUEST request = {};
+        request.common.msgType = CB_FORMAT_DATA_REQUEST;
+        request.common.dataLen = 4;
+        request.requestedFormatId = CF_UNICODETEXT;
+        requestedRevision = selectionRevision;
+        clientDataPending = clipContext->ServerFormatDataRequest(clipContext.get(), &request) == CHANNEL_RC_OK;
+    }
 };
 
