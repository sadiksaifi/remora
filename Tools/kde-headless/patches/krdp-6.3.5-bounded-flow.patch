+void VideoStream::updateInFlightWindow()
+{
+    const auto rttMs = clk::duration_cast<clk::milliseconds>(d->session->networkDetection()->averageRTT()).count();
+    qsizetype window = MinimumInFlightFrames;
+    if (rttMs > 0 && rttMs < 60000) {
+        // One round trip of frames, bounded by one second of source video.
+        window = std::clamp(qsizetype(std::ceil(d->requestedFrameRate * rttMs / 1000.0)),
+                            MinimumInFlightFrames, qsizetype(d->requestedFrameRate));
+    }
+    d->maxInFlight.store(window);
+    wakeSender();
+}
+
+void VideoStream::wakeSender()
+{
+    // Serialize notifications for ACK/window changes with the sender's wait.
+    std::lock_guard lock(d->frameQueueMutex);
+    d->frameReady.notify_all();
+}
+
+bool VideoStream::hasInFlightCapacity() const
+{
+    std::lock_guard lock(d->pendingFramesMutex);
+    return d->frameAcknowledgementSuspended || d->pendingFrames.size() < d->maxInFlight.load();
+}
+
+void VideoStream::updateBackpressure()
+{
+    qsizetype queued;
+    {
+        std::lock_guard lock(d->frameQueueMutex);
+        queued = d->frameQueue.size();
+    }
+    if (!d->encoderPaused && queued > HighQueueCount) {
+        d->encoderPaused = true;
+        Q_EMIT encoderPausedChanged(true);
+    } else if (d->encoderPaused && queued < LowQueueCount) {
+        d->encoderPaused = false;
+        Q_EMIT encoderPausedChanged(false);
     }
 }
 }
