#!/usr/bin/env bash
#MISE description="Build and sign the DMG from the app that release:app built."
set -euo pipefail
app=build/release/export/Remora.app
version=$(plutil -extract CFBundleShortVersionString raw -o - "$app/Contents/Info.plist")
stage=build/release/dmg
dist=build/release/dist
dmg="$dist/Remora-$version-macos-arm64.dmg"
rm -rf "$stage" "$dist"
mkdir -p "$stage" "$dist"
ditto "$app" "$stage/Remora.app"
ln -s /Applications "$stage/Applications"
hdiutil create -quiet -fs APFS -format ULFO -volname Remora -srcfolder "$stage" "$dmg"
codesign --sign "Developer ID Application" --timestamp "$dmg"
codesign --verify --strict --verbose=2 "$dmg"
