#!/usr/bin/env bash
#MISE description="Create the GitHub release for a tag with the DMG, SHA256SUMS and appcast.xml in build/release/dist."
#USAGE arg "<tag>" help="Stable release tag, for example v1.2.3"
#USAGE arg "<commit>" help="Commit the tag must point to on origin"
set -euo pipefail
tag="$usage_tag"
commit="$usage_commit"
version=${tag#v}
dist=build/release/dist
dmg="Remora-$version-macos-arm64.dmg"
# SHA256SUMS must list only this DMG, and the DMG must match it.
[[ $(cut -d ' ' -f 3- "$dist/SHA256SUMS") == "$dmg" ]] || { echo "$dist/SHA256SUMS does not list only $dmg" >&2; exit 1; }
(cd "$dist" && shasum -a 256 --check SHA256SUMS)
grep -qF "url=\"https://github.com/sadiksaifi/remora/releases/download/$tag/$dmg\"" "$dist/appcast.xml" || { echo "$dist/appcast.xml does not offer $dmg" >&2; exit 1; }
notes=$(mktemp)
trap 'rm -f "$notes"' EXIT
{
    echo "[![Download for macOS](https://img.shields.io/badge/Download-macOS-10B981?style=for-the-badge&labelColor=1F2937&logo=apple&logoColor=white)](https://github.com/sadiksaifi/remora/releases/download/$tag/$dmg)"
    echo
    mise run release:notes:tag "$tag"
} > "$notes"
remote=$(gh api "repos/{owner}/{repo}/commits/refs/tags/$tag" --jq .sha)
[[ $remote == "$commit" ]] || { echo "Tag $tag points to $remote on origin, not $commit" >&2; exit 1; }
gh release create "$tag" --verify-tag --latest --title "Remora $version" --notes-file "$notes" "$dist/$dmg" "$dist/SHA256SUMS" "$dist/appcast.xml"
