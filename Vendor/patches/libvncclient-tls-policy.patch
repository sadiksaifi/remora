+/* During an exact read, existing buffered bytes are insufficient. Do not let
+ * WaitForMessage treat those same bytes as new socket readiness, otherwise
+ * a partial message burns through its timeout in a busy loop. */
+static void wait_for_more_bytes(rfbClient *client, unsigned int usecs)
+{
+  unsigned int buffered = client->buffered;
+  client->buffered = 0;
+  WaitForMessage(client, usecs);
+  client->buffered = buffered;
+}
