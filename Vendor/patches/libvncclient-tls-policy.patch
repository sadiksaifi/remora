+void rfbRemoraRuntimeStage(rfbClient* client, uint32_t stage)
+{
+  if (client->remoraDiagnostic.phase != RFB_REMORA_READY || client->remoraRuntime.failure) return;
+  client->remoraRuntime.stage = stage;
+  client->remoraRuntime.operation = 0;
+}
+void rfbRemoraRuntimeOperation(rfbClient* client, uint32_t operation)
+{
+  if (client->remoraDiagnostic.phase == RFB_REMORA_READY && !client->remoraRuntime.failure)
+    client->remoraRuntime.operation = operation;
+}
+void rfbRemoraRuntimeMessage(rfbClient* client, uint32_t stage)
+{
+  rfbRemoraRuntimeDiagnostic* d = &client->remoraRuntime;
+  if (client->remoraDiagnostic.phase != RFB_REMORA_READY || d->failure) return;
+  rfbRemoraRuntimeStage(client, stage);
+  d->messageType = d->rectIndex = -1;
+  d->rectCount = d->x = d->y = d->width = d->height = 0;
+  d->encoding = -2147483649LL;
+}
+void rfbRemoraRuntimeFail(rfbClient* client, uint32_t failure, int systemError, uint64_t opensslError)
+{
+  rfbRemoraRuntimeDiagnostic* d = &client->remoraRuntime;
+  if (client->remoraDiagnostic.phase != RFB_REMORA_READY || d->failure) return;
+  d->failure = failure; d->systemError = systemError; d->opensslError = opensslError;
+  d->framebufferWidth = client->width; d->framebufferHeight = client->height;
+}
+void rfbRemoraDiagnosticBegin(rfbClient* client, uint32_t phase)
+{
+  if (!client->remoraDiagnostic.failure) client->remoraDiagnostic.phase = phase;
+}
+void rfbRemoraDiagnosticComplete(rfbClient* client, uint32_t phase)
+{
+  if (client->remoraDiagnostic.failure) return;
+  client->remoraDiagnostic.phase = client->remoraDiagnostic.lastSuccess = phase;
+}
+void rfbRemoraDiagnosticFail(rfbClient* client, uint32_t failure, int systemError, uint64_t opensslError)
+{
+  rfbRemoraDiagnostic* d = &client->remoraDiagnostic;
+  if (d->phase == RFB_REMORA_READY) {
+    rfbRemoraRuntimeFail(client, failure, systemError, opensslError);
+    return;
+  }
+  if (d->failure) return;
+  d->failure = failure; d->systemError = systemError; d->opensslError = opensslError;
+}
+static void remora_crypto_begin(rfbClient* client, uint32_t phase)
+{
+  rfbRemoraDiagnosticBegin(client, phase);
+#ifdef LIBVNCSERVER_HAVE_LIBSSL
+  ERR_clear_error();
+#endif
+}
+static void remora_crypto_failed(rfbClient* client)
+{
+  uint64_t error = 0;
+#ifdef LIBVNCSERVER_HAVE_LIBSSL
+  error = ERR_peek_last_error();
+#endif
+  rfbRemoraDiagnosticFail(client, RFB_REMORA_CRYPTO, 0, error);
+}
