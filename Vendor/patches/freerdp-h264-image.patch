+INT32 h264_decompress_image(H264_CONTEXT *h264, const BYTE *pSrcData, UINT32 SrcSize, void **image)
+{
+	if (!h264 || !image || h264->Compressor || !h264->pSystemData ||
+	    (h264->subsystem != &g_Subsystem_VideoToolbox))
+		return -1;
+	*image = nullptr;
+	const int status = videotoolbox_decompress(h264, pSrcData, SrcSize);
+	if (status <= 0)
+		return status;
+	H264_CONTEXT_VIDEOTOOLBOX *sys = h264->pSystemData;
+	*image = (void *)CVPixelBufferRetain(sys->image);
+	return 1;
+}
